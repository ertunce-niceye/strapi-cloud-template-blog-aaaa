{
  "kind": "collectionType",
  "collectionName": "page_templates",
  "info": {
    "singularName": "page-template",
    "pluralName": "page-templates",
    "displayName": "PageTemplate"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "TemplateName": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "TemplateUID": {
      "type": "uid",
      "required": true
    },
    "Description": {
      "type": "text"
    },
    "IsGlobal": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "StyleVariant": {
      "type": "enumeration",
      "enum": [
        "default",
        "modern",
        "classic",
        "minimal",
        "corporate"
      ],
      "default": "default",
      "required": true
    },
    "ColorPalette": {
      "type": "json",
      "required": false
    },
    "LayoutConfig": {
      "type": "json",
      "required": false
    },
    "TemplatePreview": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "Companies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::company.company",
      "inversedBy": "AllowedTemplates"
    }
  }
}