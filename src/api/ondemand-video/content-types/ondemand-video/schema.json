{
  "kind": "collectionType",
  "collectionName": "ondemand_videos",
  "info": {
    "singularName": "ondemand-video",
    "pluralName": "ondemand-videos",
    "displayName": "OnDemand Video"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "VideoTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "Slug": {
      "type": "uid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "targetField": "VideoTitle",
      "required": true
    },
    "RecordingDate": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "VideoFile": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "videos"
      ]
    },
    "DurationSeconds": {
      "type": "integer"
    },
    "Speakers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::speaker.speaker"
    },
    "webinar": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::webinar.webinar",
      "inversedBy": "OnDemandVideos"
    },
    "on_demand_video_logs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::on-demand-video-logs.on-demand-video-logs",
      "private": true,
      "mappedBy": "on_demand_video"
    }
  }
}
