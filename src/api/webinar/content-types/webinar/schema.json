{
  "kind": "collectionType",
  "collectionName": "webinars",
  "info": {
    "singularName": "webinar",
    "pluralName": "webinars",
    "displayName": "Webinar"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "Webinar_Title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "Slug": {
      "type": "uid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "targetField": "Webinar_Title",
      "required": true
    },
    "Company": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::company.company",
      "inversedBy": "Webinars"
    },
    "PageTemplate": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page-template.page-template"
    },
    "Start_DateTime": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "Registration_Closed_Time": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "RequireRegistration": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true,
      "default": true
    },
    "On_Demand_Available": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": false
    },
    "Speakers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::speaker.speaker",
      "mappedBy": "webinars"
    },
    "Landing_Page_Layout": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "components": [
        "page-sections.section-hero",
        "page-sections.section-agenda-block",
        "page-sections.section-speaker-grid",
        "page-sections.block-session-cards"
      ]
    },
    "webinar": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::webinar.webinar",
      "inversedBy": "Related_Webinars"
    },
    "Related_Webinars": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::webinar.webinar",
      "mappedBy": "webinar"
    },
    "Registration_Success_Message": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "conditions": {
        "visible": {
          "!=": [
            {
              "var": "RequireRegistration"
            },
            false
          ]
        }
      }
    },
    "On_Demand_Video_URL": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "Registration_Definition": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "conditions": {
        "visible": {
          "!=": [
            {
              "var": "RequireRegistration"
            },
            false
          ]
        }
      },
      "components": [
        "form-fields.field-text-input",
        "form-fields.field-email-address",
        "form-fields.field-dropdown-select",
        "form-fields.field-country-picker",
        "form-fields.field-consent-checkbox"
      ]
    },
    "Zoom_Setup_Config": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "webinar-details.zoom-event-setup",
      "repeatable": false
    },
    "Email_Config": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "webinar-details.email-automation-settings",
      "repeatable": true
    },
    "Watching_Page_Layout": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "components": [
        "live-page.live-resources-block",
        "live-page.live-q-a-panel",
        "live-page.live-cta-block"
      ]
    },
    "Survey_Post_Webinar_URL": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "Section_Footer": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "page-sections.section-footer",
      "repeatable": false
    }
  }
}
