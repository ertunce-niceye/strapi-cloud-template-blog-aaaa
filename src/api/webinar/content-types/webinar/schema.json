{
  "kind": "collectionType",
  "collectionName": "webinars",
  "info": {
    "singularName": "webinar",
    "pluralName": "webinars",
    "displayName": "Webinar"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "Webinar_Title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "DryRun_Available": {
      "type": "boolean",
      "default": false
    },
    "DryRun_Date": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "DryRun_Context": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "DryRun_List": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "Slug": {
      "type": "uid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "targetField": "Webinar_Title",
      "required": true
    },
    "Company": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::company.company",
      "inversedBy": "Webinars"
    },
    "Team": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::team.team",
      "inversedBy": "Webinars"
    },
    "Start_DateTime": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": false
    },
    "Registration_Closed_Time": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": false
    },
    "RequireRegistration": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true,
      "default": true
    },
    "On_Demand_Available": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": false
    },
    "Speakers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::speaker.speaker",
      "mappedBy": "webinars"
    },
    "Landing_Page_Layout": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "components": [
        "page-sections.section-hero",
        "page-sections.section-agenda-block",
        "page-sections.section-speaker-grid",
        "page-sections.block-session-cards",
        "page-sections.section-footer"
      ]
    },
    "webinar": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::webinar.webinar",
      "inversedBy": "Related_Webinars"
    },
    "Related_Webinars": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::webinar.webinar",
      "mappedBy": "webinar"
    },
    "Registration_Success_Message": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "conditions": {
        "visible": {
          "!=": [
            {
              "var": "RequireRegistration"
            },
            false
          ]
        }
      }
    },
    "Registration_Exist_Message": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "conditions": {
        "visible": {
          "!=": [
            {
              "var": "RequireRegistration"
            },
            false
          ]
        }
      }
    },
    "On_Demand_Video_URL": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "Registration_Definition": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "conditions": {
        "visible": {
          "!=": [
            {
              "var": "RequireRegistration"
            },
            false
          ]
        }
      },
      "components": [
        "form-fields.field-text-input",
        "form-fields.field-email-address",
        "form-fields.field-dropdown-select",
        "form-fields.field-country-picker",
        "form-fields.field-consent-checkbox",
        "form-fields.field-name",
        "form-fields.field-speciality"
      ]
    },
    "Country_Config": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "Speciality_Config": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "Zoom_Setup_Config": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "webinar-details.zoom-event-setup",
      "repeatable": false
    },
    "Email_Config": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "webinar-details.email-automation-settings",
      "repeatable": false
    },
    "Watching_Page_Layout": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "components": [
        "live-page.live-resources-block",
        "live-page.live-resources-block",
        "live-page.live-cta-block",
        "live-page.live-design-settings"
      ]
    },
    "Registration_Closed_Message": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "conditions": {
        "visible": {
          "!=": [
            {
              "var": "RequireRegistration"
            },
            false
          ]
        }
      }
    },
    "EventTimeZone": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true,
      "enum": [
        "Europe/Istanbul",
        "America/New_York",
        "Europe/London",
        "Europe/Paris"
      ]
    },
    "EventStartDate": {
      "type": "date",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "EventStartTime": {
      "type": "time",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "RegistrationCloseDate": {
      "type": "date",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "RegistrationCloseTime": {
      "type": "time",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "EventDuration": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "OnDemandVideos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::ondemand-video.ondemand-video",
      "mappedBy": "webinar"
    },
    "on_demand_video_logs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::on-demand-video-logs.on-demand-video-logs",
      "private": true,
      "mappedBy": "webinar"
    },
    "Evaluation_Survey": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "evaluation.evaluation-survey",
      "repeatable": false
    },
    "Moderator_List": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "webinar-details.moderator-entry",
      "repeatable": true
    },
    "Certificate_Active": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": false
    },
    "Certificate_Config": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "Survey_Active": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": false
    },
    "Survey_Available": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": false
    },
    "Certificate_Available": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": false
    },
    "Is_Manually_Ended": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": false
    },
    "is_purchased": {
      "type": "boolean",
      "default": false
    },
    "purchased_event_type": {
      "type": "enumeration",
      "enum": [
        "webinar",
        "meeting"
      ]
    },
    "Survey_Responses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::survey-response.survey-response",
      "mappedBy": "Webinar"
    },
    "Wizard_Progress": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "EventType": {
      "type": "enumeration",
      "required": true,
      "default": "Webinar",
      "enum": [
        "Webinar",
        "Meeting"
      ]
    },
    "AutoUnpublish_DateTime": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "AutoRetire_Date": {
      "type": "date",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "AutoRetire_Time": {
      "type": "time",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "AutoRetire_Enabled": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": false
    },
    "Is_Retired": {
      "type": "boolean",
      "default": false
    },
    "Report_Summary": {
      "type": "json"
    },
    "media_folder_id": {
      "type": "integer"
    }
  }
}